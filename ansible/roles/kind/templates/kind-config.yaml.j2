kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4

nodes:
  - role: control-plane
{% if kind_extra_port_mappings %}
    extraPortMappings:
{% for mapping in kind_extra_port_mappings %}
      - containerPort: {{ mapping.containerPort }}
        hostPort: {{ mapping.hostPort }}
        protocol: {{ mapping.protocol }}
{% endfor %}
{% endif %}