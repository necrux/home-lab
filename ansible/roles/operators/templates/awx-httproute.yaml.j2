apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: awx
  namespace: {{ operators_awx_namespace }}
spec:
  parentRefs:
    - name: {{ operators_gateway_name }}
      namespace: {{ operators_gateway_namespace }}
  hostnames:
    - "{{ operators_awx_hostname }}"
  rules:
    - backendRefs:
        - name: {{ operators_awx_service_name }}
          port: {{ operators_awx_service_port }}