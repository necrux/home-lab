apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{ operators_cert_manager_ca_name }}
  namespace: {{ operators_cert_manager_ca_namespace }}
spec:
  isCA: true
  commonName: {{ operators_cert_manager_ca_common_name | quote }}
  secretName: {{ operators_cert_manager_ca_secret_name }}
  duration: {{ operators_cert_manager_ca_duration }}
  renewBefore: {{ operators_cert_manager_ca_renew_before }}
  issuerRef:
    name: {{ operators_cert_manager_ca_issuer_name }}
    kind: ClusterIssuer
    group: cert-manager.io