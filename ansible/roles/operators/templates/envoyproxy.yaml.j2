apiVersion: gateway.envoyproxy.io/v1alpha1
kind: EnvoyProxy
metadata:
  name: {{ operators_envoy_proxy_name }}
  namespace: {{ operators_envoy_proxy_namespace }}
spec:
  provider:
    type: Kubernetes
    kubernetes:
      envoyService:
        type: NodePort
        externalTrafficPolicy: Local
        patch:
          type: JSONMerge
          value:
            spec:
              ports:
                - name: http-80
                  nodePort: {{ operators_envoy_http_node_port }}
                  port: 80
                  protocol: TCP
                  targetPort: 10080